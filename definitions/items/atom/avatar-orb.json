{
  "kind": "atom",
  "name": "avatar-orb",
  "fingerprint": "7b2a6aa3839de1e6",
  "bundle": "design-system",
  "title": "avatar-orb",
  "description": "An assistant avatar whose face changes with the live call phase, ringed by a procedural orb while the call is active. Owns its full style — references tokens only. Reads the projected `callState` directly (idle|active|userSpeaking|agentSpeaking), exactly as agent-avatar does.",
  "definition": {
    "unoverse": "1.0",
    "kind": "atom",
    "name": "avatar-orb",
    "description": "An assistant avatar whose face changes with the live call phase, ringed by a procedural orb while the call is active. Owns its full style — references tokens only. Reads the projected `callState` directly (idle|active|userSpeaking|agentSpeaking), exactly as agent-avatar does.",
    "whenToUse": "The animated avatar for a voice / live-agent surface whose host carries a `callState` field (idle|active|userSpeaking|agentSpeaking). Compose via a Ref, passing size/speed/colour as literals with `with`; the halo and portrait key off `callState` directly. At rest it is just the face — the orb appears when the call goes live. For a person's photo in a list or a review use the avatar atom instead.",
    "props": {
      "callState": {
        "type": "string",
        "default": "idle",
        "enum": [
          "idle",
          "active",
          "userSpeaking",
          "agentSpeaking"
        ]
      },
      "size": {
        "type": "string",
        "default": "200"
      },
      "orbColor": {
        "type": "string",
        "default": "orb.ink-soft",
        "enum": [
          "orb.ink-faint",
          "orb.ink-soft",
          "orb.ink",
          "orb.brand"
        ]
      },
      "speed": {
        "type": "string",
        "default": "1"
      }
    },
    "root": {
      "type": "Box",
      "style": {
        "display": "inline-flex",
        "direction": "row",
        "position": "relative",
        "align": "center",
        "justify": "center",
        "padding": "12"
      },
      "children": [
        {
          "type": "Switch",
          "on": "callState",
          "cases": {
            "active": {
              "type": "Orb",
              "state": "halo",
              "bind": {
                "speed": "speed",
                "size": "size"
              },
              "style": {
                "position": "absolute",
                "inset": "0",
                "margin": "auto",
                "color": "{{orbColor}}"
              }
            },
            "userSpeaking": {
              "type": "Orb",
              "state": "sonar",
              "bind": {
                "speed": "speed",
                "size": "size"
              },
              "style": {
                "position": "absolute",
                "inset": "0",
                "margin": "auto",
                "color": "{{orbColor}}"
              }
            },
            "agentSpeaking": {
              "type": "Orb",
              "state": "pulse",
              "bind": {
                "speed": "speed",
                "size": "size"
              },
              "style": {
                "position": "absolute",
                "inset": "0",
                "margin": "auto",
                "color": "{{orbColor}}"
              }
            }
          }
        },
        {
          "type": "Box",
          "style": {
            "position": "relative",
            "zIndex": "1",
            "width": "28",
            "height": "28",
            "radius": "full",
            "overflow": "hidden",
            "background": "surface.sunken",
            "shadow": "lg"
          },
          "children": [
            {
              "type": "Switch",
              "on": "callState",
              "cases": {
                "active": {
                  "type": "Image",
                  "src": "https://res.cloudinary.com/sonik/image/upload/v1786260874/gravity/waiting.jpg",
                  "alt": "The assistant, ready",
                  "style": {
                    "width": "full",
                    "height": "full",
                    "fit": "cover"
                  }
                },
                "userSpeaking": {
                  "type": "Image",
                  "src": "https://res.cloudinary.com/sonik/image/upload/v1786260875/gravity/listening.jpg",
                  "alt": "The assistant, listening",
                  "style": {
                    "width": "full",
                    "height": "full",
                    "fit": "cover"
                  }
                },
                "agentSpeaking": {
                  "type": "Image",
                  "src": "https://res.cloudinary.com/sonik/image/upload/v1786260874/gravity/responding.jpg",
                  "alt": "The assistant, responding",
                  "style": {
                    "width": "full",
                    "height": "full",
                    "fit": "cover"
                  }
                },
                "default": {
                  "type": "Image",
                  "src": "https://res.cloudinary.com/sonik/image/upload/v1786260874/gravity/waiting.jpg",
                  "alt": "The assistant, waiting",
                  "style": {
                    "width": "full",
                    "height": "full",
                    "fit": "cover"
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "file": "avatar-orb.yaml"
  }
}
