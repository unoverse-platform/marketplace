    "name": "form-file",
    "category": "markdown",
    "description": "One collected document: a label, the platform's file chooser, and the name of whatever was chosen.",
    "whenToUse": "Collect a document a person must provide: proof of identity, proof of address, a signed form, a statement. Not for a value they type, and not for a document the platform already holds.",
    "props": {
      "label": {
        "type": "string",
        "description": "WHICH DOCUMENT is wanted, in the person's words: 'Proof of address', 'Signed subscription form'. Name the document the source actually requires, never one you think would help.",
        "maxLength": 60,
        "preview": "Proof of address",
        "default": "Label"
      },
      "value": {
        "type": "string",
        "preview": "",
        "default": ""
      },
      "help": {
        "type": "string",
        "description": "What makes a document acceptable, when the source says: how recent it must be, whose name it must carry, which formats are allowed. Empty when the source sets no condition.",
        "maxLength": 160,
        "optional": true,
        "preview": "A utility bill or bank statement from the last three months.",
        "default": ""
      },
      "required": {
        "type": "boolean",
        "preview": true,
        "default": false
      },
      "source": {
        "type": "string",
        "preview": "",
        "default": ""
      }
    },
