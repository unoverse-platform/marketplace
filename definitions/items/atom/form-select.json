{
  "kind": "atom",
  "name": "form-select",
  "fingerprint": "ac66f340fced60f3",
  "bundle": "design-system",
  "title": "form-select",
  "description": "One collected choice: a label, the options laid out as selectable rows, and a chip naming where a proposed value came from.",
  "category": "markdown",
  "definition": {
    "unoverse": "1.0",
    "name": "form-select",
    "category": "markdown",
    "description": "One collected choice: a label, the options laid out as selectable rows, and a chip naming where a proposed value came from.",
    "whenToUse": "Collect one answer from a SET the source defines: a class, a classification, a country, a frequency. Not for a yes or no, which is form-toggle, and not for an answer the person types in their own words.",
    "props": {
      "label": {
        "type": "string",
        "default": "Label",
        "preview": "Share class"
      },
      "value": {
        "type": "string",
        "default": "",
        "preview": "A"
      },
      "help": {
        "type": "string",
        "default": "",
        "preview": "Class I requires a commitment of £5m or more."
      },
      "required": {
        "type": "boolean",
        "default": false,
        "preview": true
      },
      "source": {
        "type": "string",
        "default": "",
        "preview": "From the deal's terms"
      },
      "options": {
        "type": "array",
        "default": [],
        "preview": [
          {
            "label": "A",
            "description": "EUR, minimum €250k"
          },
          {
            "label": "B",
            "description": "USD, minimum $300k"
          },
          {
            "label": "I",
            "description": "EUR, minimum €5m"
          }
        ]
      }
    },
    "root": {
      "type": "Box",
      "style": {
        "direction": "column",
        "gap": "1.5",
        "width": "full"
      },
      "children": [
        {
          "type": "Box",
          "style": {
            "direction": "row",
            "align": "center",
            "justify": "space-between",
            "gap": "3",
            "width": "full"
          },
          "children": [
            {
              "type": "Box",
              "style": {
                "direction": "row",
                "align": "center",
                "gap": "1"
              },
              "children": [
                {
                  "type": "Text",
                  "brief": {
                    "description": "What is being chosen, in a few words: 'Share class', 'Investor classification'. A noun phrase, never a question.",
                    "maxLength": 60
                  },
                  "bind": {
                    "value": "label"
                  },
                  "style": {
                    "font": "label",
                    "weight": "medium",
                    "color": "text.secondary"
                  }
                },
                {
                  "type": "Text",
                  "visibleWhen": "required",
                  "value": "*",
                  "style": {
                    "font": "label",
                    "weight": "bold",
                    "color": "action.primary"
                  }
                }
              ]
            },
            {
              "type": "Ref",
              "ref": "pill",
              "visibleWhen": "source",
              "props": {
                "label": "source"
              },
              "style": {
                "background": "action.subtle"
              }
            }
          ]
        },
        {
          "type": "Box",
          "visibleWhen": {
            "field": "value",
            "ne": ""
          },
          "style": {
            "direction": "row",
            "align": "center",
            "justify": "space-between",
            "gap": "3",
            "width": "full",
            "padding": [
              "3",
              "4"
            ],
            "background": "surface.base",
            "border": "strong",
            "radius": "sm"
          },
          "children": [
            {
              "type": "Text",
              "bind": {
                "value": "value"
              },
              "style": {
                "font": "body.md",
                "weight": "medium",
                "color": "text.primary"
              }
            },
            {
              "type": "Icon",
              "icon": "check",
              "style": {
                "flex": "0 0 auto",
                "width": "4",
                "height": "4",
                "color": "action.primary"
              }
            }
          ]
        },
        {
          "type": "Each",
          "visibleWhen": {
            "field": "value",
            "eq": ""
          },
          "brief": {
            "description": "The options the source defines, in its own order and its own words. Never invent an option, never drop one because it seems unlikely, and never add 'Other' unless the source offers it.",
            "minItems": 2,
            "maxItems": 8
          },
          "bind": {
            "items": "options"
          },
          "style": {
            "direction": "column",
            "gap": "2",
            "width": "full"
          },
          "template": {
            "type": "Ref",
            "ref": "choice-row",
            "props": {
              "label": "label",
              "description": "description"
            }
          }
        },
        {
          "type": "Text",
          "visibleWhen": "help",
          "bind": {
            "value": "help"
          },
          "style": {
            "font": "caption",
            "color": "text.tertiary"
          }
        }
      ]
    },
    "file": "form-select.yaml",
    "kind": "atom"
  }
}
