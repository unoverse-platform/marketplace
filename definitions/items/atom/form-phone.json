  "title": "form-phone",
  "description": "One collected phone number: a label, the platform's phone keypad, and a chip naming where a proposed value came from.",
  "category": "markdown",
  "definition": {
    "unoverse": "1.0",
    "kind": "atom",
    "name": "form-phone",
    "category": "markdown",
    "description": "One collected phone number: a label, the platform's phone keypad, and a chip naming where a proposed value came from.",
    "whenToUse": "Collect a telephone number a person types or confirms, for a callback, a verification or a contact record. Not for a country dialling code on its own, which is a choice from a set.",
    "props": {
      "label": {
        "type": "string",
        "default": "Label",
        "preview": "Phone number"
      },
      "value": {
        "type": "string",
        "default": "",
        "preview": "7700 900123"
      },
      "placeholder": {
        "type": "string",
        "default": "",
        "preview": "e.g. 7700 900123"
      },
      "help": {
        "type": "string",
        "default": "",
        "preview": "An advisor will call this number, usually within one working day."
      },
      "required": {
        "type": "boolean",
        "default": false,
        "preview": true
      },
      "source": {
        "type": "string",
        "default": "",
        "preview": "From your profile"
      }
    },
    "root": {
      "type": "Box",
      "style": {
        "direction": "column",
        "gap": "1.5",
        "width": "full"
      },
      "children": [
        {
          "type": "Box",
          "style": {
            "direction": "row",
            "align": "center",
            "justify": "space-between",
            "gap": "3",
            "width": "full"
          },
          "children": [
            {
              "type": "Box",
              "style": {
                "direction": "row",
                "align": "center",
                "gap": "1"
              },
              "children": [
                {
                  "type": "Text",
                  "bind": {
                    "value": "label"
                  },
                  "style": {
                    "font": "label",
                    "weight": "medium",
                    "color": "text.secondary"
                  }
                },
                {
                  "type": "Text",
                  "visibleWhen": "required",
                  "value": "*",
                  "style": {
                    "font": "label",
                    "weight": "bold",
                    "color": "action.primary"
                  }
                }
              ]
            },
            {
              "type": "Ref",
              "ref": "pill",
              "visibleWhen": "source",
              "props": {
                "label": "source"
              },
              "style": {
                "background": "action.subtle"
              }
            }
          ]
        },
        {
          "type": "Input",
          "inputType": "tel",
          "autoComplete": "tel",
          "brief": {
            "description": "Propose the number the person's profile actually holds, copied exactly, digits and spacing as stated. Never construct one from a country or an address, and leave it out when nothing states it: a wrong number is a call that never comes.",
            "optional": true,
            "maxLength": 32
          },
          "bind": {
            "placeholder": "placeholder",
            "value": "value"
          },
          "style": {
            "width": "full",
            "font": "body.md",
            "color": "text.primary",
            "background": "surface.base",
            "border": "subtle",
            "radius": "sm",
            "padding": [
              "2",
              "3"
            ],
            "minHeight": "10"
          }
        },
        {
          "type": "Text",
          "visibleWhen": "help",
          "bind": {
            "value": "help"
          },
          "style": {
            "font": "caption",
            "color": "text.tertiary"
          }
        }
      ]
    },
    "file": "form-phone.yaml"
  }
}
