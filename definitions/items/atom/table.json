{
  "kind": "atom",
  "name": "table",
  "fingerprint": "d9fe87ed06c169a7",
  "bundle": "design-system",
  "title": "table",
  "description": "A two-dimensional table: a header row of column names above rows of cells, scrolling inside its own frame rather than widening its container. Owns its full style, references tokens only.",
  "category": "markdown",
  "definition": {
    "unoverse": "1.0",
    "name": "table",
    "category": "markdown",
    "description": "A two-dimensional table: a header row of column names above rows of cells, scrolling inside its own frame rather than widening its container. Owns its full style, references tokens only.",
    "whenToUse": "Anything the source states across two dimensions, such as rates by type or sizes by price. A single list of figures is keyFacts; a list of items is a list.",
    "props": {
      "columns": {
        "type": "array",
        "description": "The column headers, in the source's own words. Two to five; a table wider than that belongs as several sections.",
        "minItems": 2,
        "maxItems": 5,
        "default": [
          "Type",
          "Rate"
        ]
      },
      "rows": {
        "type": "array",
        "description": "The rows, each a list of cells in the SAME ORDER as the columns and the same length. Every cell is quoted from the source, never calculated or filled in to complete the grid.",
        "minItems": 2,
        "maxItems": 20,
        "items": {
          "value": {
            "type": "array",
            "description": "One row's cells, in the same order as the columns and the same length."
          }
        },
        "default": [
          [
            "Standard",
            "2.5%"
          ],
          [
            "Preferential",
            "1.9%"
          ]
        ]
      }
    },
    "root": {
      "type": "Box",
      "style": {
        "width": "full",
        "overflow": "hidden",
        "border": "thin subtle",
        "radius": "lg"
      },
      "children": [
        {
          "type": "Box",
          "style": {
            "direction": "row",
            "width": "full",
            "gap": "0",
            "padding": [
              "3",
              "4"
            ],
            "background": "surface.sunken",
            "borderBottom": "thin subtle"
          },
          "children": [
            {
              "type": "Each",
              "bind": {
                "items": "columns"
              },
              "style": {
                "direction": "row",
                "width": "full",
                "gap": "4"
              },
              "item": {
                "type": "Text",
                "bind": {
                  "value": "value"
                },
                "style": {
                  "flex": 1,
                  "minWidth": "0",
                  "font": "caption",
                  "weight": "semibold",
                  "color": "text.tertiary"
                }
              }
            }
          ]
        },
        {
          "type": "Each",
          "bind": {
            "items": "rows"
          },
          "style": {
            "direction": "column",
            "width": "full"
          },
          "item": {
            "type": "Each",
            "bind": {
              "items": "value"
            },
            "style": {
              "direction": "row",
              "width": "full",
              "gap": "4",
              "padding": [
                "3",
                "4"
              ],
              "borderBottom": "thin subtle"
            },
            "item": {
              "type": "Text",
              "bind": {
                "value": "value"
              },
              "style": {
                "flex": 1,
                "minWidth": "0",
                "font": "body.sm",
                "color": "text.secondary"
              }
            }
          }
        }
      ]
    },
    "file": "table.yaml",
    "kind": "atom"
  }
}
