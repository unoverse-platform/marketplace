    "name": "form-number",
    "category": "markdown",
    "description": "One collected whole number: a label, a digits-only input, a help line, and a chip naming where a proposed value came from.",
    "whenToUse": "Collect a count a person types or confirms: a number of years, a quantity, an age, a number of employees. Digits only, so not for an amount of money, a percentage or anything with a decimal point.",
    "props": {
      "label": {
        "type": "string",
        "preview": "Years at your current address",
        "default": "Label"
      },
      "value": {
        "type": "string",
        "description": "Propose this number ONLY from what the person's profile, the record, or a document they uploaded actually states, as digits with no unit and no separators. Never calculate it, never estimate it, and leave it out when nothing states it. An empty field is correct; a guessed one is a defect they may confirm without noticing.",
        "maxLength": 12,
        "optional": true,
        "preview": "7",
        "default": ""
      },
      "placeholder": {
        "type": "string",
        "preview": "0",
        "default": ""
      },
      "help": {
        "type": "string",
        "preview": "Whole years, rounded down.",
        "default": ""
      },
      "required": {
        "type": "boolean",
        "preview": true,
        "default": false
      },
      "source": {
        "type": "string",
        "default": ""
      }
    },
