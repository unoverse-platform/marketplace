    "unoverse": "1.0",
    "name": "form-date",
    "category": "markdown",
    "description": "One collected date: a label, the platform's own date picker, and a chip naming where a proposed value came from.",
    "whenToUse": "Collect a date a person picks or confirms, such as a date of birth, a start date or a deadline. Not for a duration or a period, which are a number and a unit.",
    "props": {
      "label": {
        "type": "string",
        "preview": "Full legal name",
        "default": "Label"
      },
      "value": {
        "type": "string",
        "description": "Propose the date ONLY when the profile or an uploaded document states it, as YYYY-MM-DD. Never infer one from an age, a year alone or a nearby date, and leave it out when nothing states it.",
        "maxLength": 10,
        "optional": true,
        "preview": "Amelia Hartley",
        "default": ""
      },
      "placeholder": {
        "type": "string",
        "preview": "As it appears on your passport",
        "default": ""
      },
      "help": {
        "type": "string",
        "preview": "We check this against your identity documents.",
        "default": ""
      },
      "required": {
        "type": "boolean",
        "preview": true,
        "default": false
      },
      "source": {
        "type": "string",
        "preview": "From your profile",
        "default": ""
      }
    },
    "root": {
      "type": "Box",
      "style": {
        "direction": "column",
        "gap": "1.5",
        "width": "full"
      },
