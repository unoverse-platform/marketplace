{
  "kind": "template",
  "name": "grid-page",
  "fingerprint": "bdfbe176d8449d88",
  "bundle": "design-system",
  "title": "Browse Grid",
  "description": "Browse a set of peer items in a responsive grid; any one opens into its own full detail page.",
  "category": "Arrangement",
  "definition": {
    "unoverse": "1.0",
    "name": "grid-page",
    "kind": "template",
    "title": "Browse Grid",
    "description": "Browse a set of peer items in a responsive grid; any one opens into its own full detail page.",
    "whenToUse": "Four to eight peer items the guest is browsing or choosing between.",
    "category": "Arrangement",
    "version": "1.0.0",
    "spatial": true,
    "layouts": {
      "grid": {
        "type": "Box",
        "style": {
          "width": "full",
          "container": "inline-size"
        },
        "children": [
          {
            "type": "Box",
            "style": {
              "width": "full",
              "padding": [
                "4",
                "0",
                "0",
                "0"
              ]
            },
            "children": [
              {
                "type": "ComponentSlot",
                "select": {
                  "from": "all",
                  "where": {
                    "field": "state",
                    "eq": "tiles"
                  },
                  "limit": 1
                }
              }
            ]
          }
        ]
      },
      "page": {
        "type": "Box",
        "style": {
          "direction": "column",
          "width": "full"
        },
        "children": [
          {
            "type": "ComponentSlot",
            "select": {
              "from": "all",
              "where": {
                "field": "state",
                "eq": "detail"
              },
              "limit": 1
            }
          }
        ]
      }
    },
    "defaultLayout": "grid",
    "stateOrder": [
      "page"
    ],
    "publicStates": [
      "grid",
      "page"
    ],
    "initialView": "grid",
    "stateTree": [
      {
        "name": "grid"
      },
      {
        "name": "page"
      }
    ],
    "sections": {
      "grid": [
        {
          "kind": "part",
          "face": "tiles",
          "component": "components/tiles",
          "ref": "grid-page/tiles",
          "seeds": {
            "grid-page/tiles": {
              "items": [
                {
                  "title": "Lightsaber Combat Training",
                  "description": "Master the seven forms of lightsaber combat with guidance from Jedi Masters.",
                  "image": "https://res.cloudinary.com/sonik/image/upload/v1761403583/gravity/YodaPark/darth-vader-main_4560aff7.jpg",
                  "link": "[BEGIN TRAINING](https://example.com)"
                },
                {
                  "title": "Starship Piloting Fundamentals",
                  "description": "Learn to fly by instruments and by feel, from first launch to a clean landing.",
                  "image": "https://res.cloudinary.com/sonik/image/upload/v1761403583/gravity/YodaPark/darth-vader-main_4560aff7.jpg",
                  "link": "[START FLYING](https://example.com)"
                },
                {
                  "title": "The Way of the Force",
                  "description": "A guided course in focus and patience, taught live with on-demand catch-up.",
                  "image": "https://res.cloudinary.com/sonik/image/upload/v1761403583/gravity/YodaPark/darth-vader-main_4560aff7.jpg",
                  "link": "[FIND OUT MORE](https://example.com)"
                }
              ]
            }
          }
        }
      ],
      "page": [
        {
          "kind": "part",
          "face": "detail",
          "component": "components/detail",
          "ref": "grid-page/detail",
          "seeds": {
            "grid-page/detail": {
              "item": [
                {
                  "title": "Lightsaber Combat Training",
                  "description": "Master the seven forms of lightsaber combat with guidance from Jedi Masters.",
                  "image": "https://res.cloudinary.com/sonik/image/upload/v1761403583/gravity/YodaPark/darth-vader-main_4560aff7.jpg",
