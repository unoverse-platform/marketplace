  "category": "Arrangement",
  "definition": {
    "unoverse": "1.0",
    "name": "grid-page",
    "kind": "template",
    "description": "Browse a set of peer items in a responsive grid; any one opens into its own full detail page.",
    "whenToUse": "Four to eight peer items the guest is browsing or choosing between.",
    "category": "Arrangement",
    "version": "1.0.0",
    "spatial": true,
    "layouts": {
      "grid": {
        "type": "Box",
        "style": {
          "width": "full",
          "container": "inline-size"
        },
        "children": [
          {
            "type": "Box",
            "style": {
              "columns": {
                "mobile": "1",
                "tablet": "2",
                "desktop": "3",
                "full": "4"
              },
              "gap": "4",
              "width": "full",
              "padding": [
                "4",
                "0",
                "0",
                "0"
              ]
            },
            "children": [
              {
                "type": "ComponentSlot",
                "select": {
                  "from": "all",
                  "where": {
                    "field": "state",
                    "eq": "grid"
                  }
                }
              }
            ]
          }
        ]
      },
      "page": {
        "type": "Box",
        "style": {
          "direction": "column",
          "width": "full"
        },
        "children": [
          {
            "type": "ComponentSlot",
            "select": {
              "from": "all",
              "where": {
                "field": "state",
                "eq": "page"
              },
              "limit": 1
            }
          }
        ]
      }
    },
    "defaultLayout": "grid",
    "stateOrder": [
      "page"
    ],
    "publicStates": [
      "grid",
      "page"
    ],
    "initialView": "grid",
    "sections": {
