          "container": "inline-size"
        },
        "children": [
          {
            "type": "Box",
            "style": {
              "columns": {
                "mobile": "1",
                "tablet": "2",
                "desktop": "3",
                "full": "4"
              },
              "gap": "4",
              "width": "full",
              "padding": [
