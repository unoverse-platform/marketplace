                "0",
                "0",
                "0"
              ]
            },
            "children": [
              {
                "type": "ComponentSlot",
                "select": {
                  "from": "all",
                  "where": {
                    "field": "view",
                    "eq": "grid"
                  }
                }
              }
            ]
          }
        ]
      },
      "page": {
        "type": "Box",
        "style": {
