{
  "kind": "component",
  "name": "composer-bar",
  "fingerprint": "c65cbd4139ca0cb1",
  "bundle": "design-system",
  "title": "composer-bar",
  "description": "The message composer: a rounded input pill with a leading chat glyph, a microphone, and a circular send button. Sits at the foot of a chat surface. Owns its full style — references semantic tokens only, so it themes per org.",
  "category": "Input",
  "definition": {
    "unoverse": "1.0",
    "kind": "component",
    "name": "composer-bar",
    "category": "Input",
    "nodeSize": {
      "width": 640,
      "height": 96
    },
    "description": "The message composer: a rounded input pill with a leading chat glyph, a microphone, and a circular send button. Sits at the foot of a chat surface. Owns its full style — references semantic tokens only, so it themes per org.",
    "whenToUse": "The always-present text-entry bar at the bottom of a conversational app. Composed into a chat app as fixed chrome; binds its draft to the app's input field.",
    "props": {
      "latched": {
        "type": "boolean",
        "default": false,
        "preview": true,
        "input": true
      },
      "latchTitle": {
        "type": "string",
        "default": "",
        "preview": "Perfect Day",
        "input": true
      }
    },
    "root": {
      "type": "Box",
      "style": {
        "direction": "row",
        "gap": "2",
        "padding": [
          "4",
          "8",
          "6",
          "8"
        ],
        "background": "transparent",
        "when": [
          {
            "field": "hasMessages",
            "eq": true,
            "apply": {
              "background": "surface.base"
            }
          }
        ]
      },
      "children": [
        {
          "type": "Box",
          "style": {
            "flex": 1,
            "direction": "row",
            "align": "center",
            "gap": "2",
            "background": "surface.raised",
            "border": "none",
            "radius": "full",
            "shadow": "md",
            "padding": [
              "3",
              "4"
            ]
          },
          "children": [
            {
              "type": "Switch",
              "on": "latched",
              "cases": {
                "default": {
                  "type": "Icon",
                  "icon": "chat",
                  "style": {
                    "width": "5",
                    "height": "5",
                    "color": "text.tertiary"
                  }
                },
                "true": {
                  "type": "Box",
                  "style": {
                    "direction": "row",
                    "align": "center",
                    "gap": "1",
                    "flex": "0 0 auto",
                    "radius": "full",
                    "padding": [
                      "1",
                      "2"
                    ],
                    "background": "action.primary"
                  },
                  "children": [
                    {
                      "type": "Text",
                      "bind": {
                        "value": "latchTitle"
                      },
                      "style": {
                        "font": "body.sm",
                        "color": "action.primary-text"
                      }
                    },
                    {
                      "type": "Button",
                      "action": {
                        "type": "setAppValue",
                        "values": [
                          {
                            "key": "latchDismissed",
                            "value": true
                          }
                        ]
                      },
                      "style": {
                        "flex": "0 0 auto",
                        "direction": "row",
                        "align": "center",
                        "justify": "center",
                        "background": "transparent",
                        "border": "none",
                        "padding": "0",
                        "cursor": "pointer"
                      },
                      "children": [
                        {
                          "type": "Icon",
                          "icon": "close",
                          "style": {
                            "width": "3",
                            "height": "3",
                            "color": "action.primary-text"
                          }
                        }
                      ]
                    }
                  ]
                }
              }
            },
            {
              "type": "Input",
              "placeholder": "Ask me anything…",
              "action": "sendMessage",
              "bind": {
                "value": "draft"
              },
              "style": {
                "flex": 1,
                "font": "body.md",
                "color": "text.primary",
                "background": "transparent",
                "border": "none",
                "outline": "none"
              }
            },
            {
              "type": "Icon",
              "icon": "mic",
              "style": {
                "width": "5",
                "height": "5",
                "color": "text.tertiary"
              }
            },
            {
              "type": "Button",
              "action": "sendMessage",
              "style": {
                "width": "10",
                "height": "10",
                "align": "center",
                "justify": "center",
                "radius": "full",
                "background": "action.primary",
                "border": "none",
                "cursor": "pointer",
                "padding": "0",
                "flex": "0 0 auto",
                "transition": "all 150ms ease",
                "hover": {
                  "background": "action.primary-hover"
                },
                "direction": "row"
              },
              "children": [
                {
                  "type": "Icon",
                  "icon": "send",
                  "style": {
                    "width": "5",
                    "height": "5",
                    "color": "action.primary-text"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
