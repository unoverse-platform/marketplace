{
  "name": "@unoverse-platform/marketplace",
  "version": "0.1.69",
  "description": "The Unoverse marketplace: components, atoms and styles, prompt blocks, skills, and declarative nodes. Definitions only, one version, installed per item.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist",
    "definitions",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "sync-defs": "node scripts/bundle-defs.mjs && tsx scripts/build-catalogue.mts && npm run build:storefront",
    "build": "tsc",
    "prepack": "node scripts/bundle-defs.mjs && tsx scripts/build-catalogue.mts && npm run build:storefront && tsc",
    "build:storefront": "cd storefront && vite build && vite build --ssr src/site/entry-server.tsx --outDir .prerender && node scripts/prerender.mjs",
    "test": "cd storefront && node --import tsx --import ./tests/css-stub.mjs --test tests/*.test.tsx"
  },
  "dependencies": {
    "uuid": "^11.1.0",
    "yaml": "^2.6.0",
    "@unoverse-platform/base": "*"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/node": "^20.19.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "jsdom": "^25.0.1",
    "lucide-react": "^0.546.0",
    "postcss": "^8.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.3.0",
    "vite": "^6.4.1"
  },
  "gravity": {
    "logoUrl": "https://res.cloudinary.com/sonik/image/upload/v1751366180/gravity/icons/gravityIcon.png",
    "nodes": [
      "Component"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "homepage": "https://github.com/unoverse-platform/unoverse",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unoverse-platform/unoverse.git",
    "directory": "packages/marketplace"
  },
  "keywords": [
    "unoverse",
    "marketplace",
    "sdui",
    "server-driven-ui",
    "components",
    "workflow",
    "nodes",
    "agents"
  ],
  "type": "module"
}
